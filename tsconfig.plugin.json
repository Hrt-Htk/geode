{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "paths": { "@noble/hashes/*": ["./node_modules/@noble/hashes/*"] }
  },
  "include": ["plugin/**/*.ts", "scripts/types/*.d.ts"]
}
