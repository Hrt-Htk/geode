# Geode on Docker. Copy this file to `.env` next to compose.yaml, fill in the token and
# uncomment ONE setup block, then `docker compose up -d`. There is no default compose
# profile: without COMPOSE_PROFILES nothing is started but Geode itself, and nothing can
# reach it.
#
# A published port bypasses ufw, so the front binds 127.0.0.1 unless GEODE_PUBLISH says
# otherwise. `host:port` is the whole value.

# Required in every setup: compose refuses to start without it. Generate it once, keep it
# (a hash instead of the token itself is #36):
#   openssl rand -base64 36 | tr -d '\n/+=' | cut -c1-40
GEODE_ADMIN_TOKEN=

# --- VPS with a domain: the bundled Caddy gets the certificate -------------
#COMPOSE_PROFILES=https
#GEODE_DOMAIN=geode.example.com
#GEODE_TRUST_PROXY=1

# --- Home server: plain HTTP, for LAN and tailnet clients ------------------
#COMPOSE_PROFILES=forward
#GEODE_PUBLISH=0.0.0.0:8080

# --- Own proxy on the same machine: nginx, Caddy, Traefik ------------------
# Your proxy must set X-Forwarded-For to the client address; the forwarder passes it
# through untouched, so the admin rate limit is one bucket per client.
#COMPOSE_PROFILES=forward
#GEODE_PUBLISH=127.0.0.1:8080
#GEODE_TRUST_PROXY=1

# GEODE_TRUST_PROXY=1 trusts X-Forwarded-For from any peer. Never combine it with a
# GEODE_PUBLISH that is not 127.0.0.1: every client could then send its own header and get
# a fresh admin rate-limit bucket per guess.

# Data lives in ./data next to compose.yaml, owned by the container's uid. SMB/CIFS
# shares do not work: the blob store needs hard links.
#   mkdir -p data && sudo chown 1993:1993 data
