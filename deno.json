{
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@noble/hashes/blake3": "npm:@noble/hashes@2.2.0/blake3.js",
    "@noble/hashes/hkdf": "npm:@noble/hashes@2.2.0/hkdf.js",
    "@noble/hashes/sha2": "npm:@noble/hashes@2.2.0/sha2.js",
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/path": "jsr:@std/path@^1",
    "@std/testing/time": "jsr:@std/testing@^1/time",
    "esbuild": "npm:esbuild@^0.25.5",
    "libsodium-sumo": "npm:libsodium-sumo@^0.7.15",
    // Alias to the CJS build: libsodium-wrappers-sumo@0.7.16's ESM entry has a
    // dangling `./libsodium-sumo.mjs` import that isn't in the package `files`,
    // so `import()`-ing the package (which picks the ESM `import` condition)
    // throws ERR_MODULE_NOT_FOUND on a clean install. The CJS entry require()s
    // the (hoisted) libsodium-sumo package and works. deno still pins the npm
    // package from this path, so it stays installed. libsodium-sumo above is a
    // direct dep so it hoists to top-level for scripts/plugin-build.ts.
    "libsodium-wrappers-sumo": "./node_modules/libsodium-wrappers-sumo/dist/modules-sumo/libsodium-wrappers.js",
    "node-diff3": "npm:node-diff3@^3.1.2",
    "postcss": "npm:postcss@^8.5.6"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "dom", "esnext"],
    "types": ["obsidian"]
  },

  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-write=./data --allow-env --allow-ffi --watch server/main.ts",
    "build:plugin": "deno run -A --node-modules-dir=auto scripts/plugin-build.ts",
    "test": "deno test --allow-all",
    "test:ci": "deno run -A scripts/test-timeout.ts",
    "fuzz:sweep": "deno run --allow-all --no-check test/fuzz/sweep.ts",
    "ci": "deno install && deno check server/main.ts core/*.ts && deno task build:plugin && deno task standards && deno task test:ci && deno task docs:drift",
    "standards": "deno fmt --check $(git ls-files '*.ts' '*.mjs' '*.json') && deno run -A scripts/standards.ts && jscpd && deno run -R scripts/check-loc.ts && deno run -R scripts/check-docs.ts && deno run -R -E --allow-run=git --env-file=.env.local scripts/check-private.ts && deno run -R --allow-run=git scripts/check-dashes.ts",
    "docs:drift": "deno run -A scripts/docs-drift.ts",
    "docs:screenshots": "deno run -A scripts/docs-screenshots.ts",
    "health": "deno run -A scripts/repo-health.ts",
    "phone": "deno run -A --env-file=.env.local scripts/phone-cli.ts",
    "phone:cdp": "deno run -A --env-file=.env.local scripts/phone-cli.ts cdp",
    "phone:status": "deno run -A --env-file=.env.local scripts/phone-cli.ts status",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "release": "deno run -A --env-file=.env.local scripts/release.ts",
    "promote": "deno run -A scripts/promote.ts",
    "after-merge": "deno run -A --env-file=.env.local scripts/after-merge.ts"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "exclude": ["plugin/_generated/"],
    "rules": {
      "include": ["prefer-const", "no-console"],
      "exclude": ["require-yield", "no-window", "no-window-prefix"]
    }
  }
}
