# Geode developer environment. Copy to .env.local at the repo root (gitignored) and
# fill in what you use. No machine-specific value has a default in the code: a missing
# required value fails with a message naming the variable. Quote any value that
# contains spaces. Tasks that need it load it themselves (`deno task release`,
# `after-merge`, `health`, `phone*`, `standards`); shell scripts such as `deploy/deploy.sh` do
# not read this file, so export what they need when running one by hand:
# `set -a; . ./.env.local; set +a`. Skills and CLAUDE.md name these variables, never
# the values. A Paseo worktree gets .env.local linked from the main checkout by
# `worktree.setup` (paseo.json).

# Code and tests

# adb serial of your test device: wireless `host:5555`, or the USB serial. Required
# by phone and hybrid runs (test/e2e/global-setup.ts).
ANDROID_SERIAL=192.0.2.10:5555
# Absolute on-device path of the vault E2E resets and installs into. Its folder name
# must match the vault Obsidian has open, or the reset interlock aborts. Required by
# runs that reset the vault (GEODE_PHONE_RESET=1) or push the build (GEODE_PHONE_PUSH=1).
GEODE_PHONE_VAULT=/storage/emulated/0/Documents/GeodeTest
# Server the phone specs create their vaults on when GEODE_PHONE_HOST is unset. Never
# a default: point it at a throwaway server, not one you care about.
GEODE_SERVER_URL=http://192.0.2.10:8090
# Admin token for that server.
GEODE_ADMIN_TOKEN=
# Port of the throwaway local server phone specs spawn when GEODE_PHONE_HOST is set.
GEODE_PHONE_SERVER_PORT=8099
# A real vault the benchmark gate drives in place, read-only (test/bench/*).
GEODE_BENCH_VAULT_DIR="/home/you/vaults/example"
# Real vault that hybrid runs and the spinner-continuity spec seed from, read-only.
GEODE_SEED_VAULT_DIR="/home/you/vaults/example"
# Tools on non-standard paths.
DENO_BIN=deno
OBSIDIAN_BIN=obsidian
ADB_PATH=adb
# ssh target for deploy/deploy.sh, as user@host. Required by that script and by the
# release: `deno task release` refuses before the version bump while it is unset.
GEODE_SSH_HOST=user@192.0.2.10
# Path to an untracked file of your own private values, one per line (`#` starts a
# comment, a leading `~/` resolves against HOME). `deno task standards` fails if
# any of them appears in a tracked file, and prints only its line number, never
# the value. Local only: leave it unset in CI. Set but unreadable or empty fails
# the gate rather than switching the layer off. `scripts/check-private.ts`
# describes the file.
GEODE_PRIVATE_DENYLIST=
# Wall-clock cap for `deno task test:ci`, in milliseconds.
GEODE_TEST_TIMEOUT_MS=900000

# Repo automation. Unset, the step that needs it is skipped.
# Node id of the project board (`gh project view N --owner OWNER --format json -q .id`).
# `after-merge` moves closed items to Done.
GEODE_BOARD=

# Agent tooling (skills only)

# USB serial of the phone, used to re-arm wireless adb after a reboot.
GEODE_PHONE_USB_SERIAL=R58M0000000
# Public URL of your production server, for read-only inspection.
GEODE_PROD_URL=https://geode.example.com

# Run flags. Leave them unset unless you want that behavior. GEODE_PHONE and
# GEODE_PHONE_RESET must be exactly `1`; GEODE_PHONE_PUSH and GEODE_PHONE_HOST are
# tested for presence, so any non-empty value switches them on. Each one is commented out.

# Include the phone and hybrid Playwright projects (desktop specs run without it).
# GEODE_PHONE=1
# Wipe the device test vault before a run (the GEODE_PHONE_VAULT interlock still applies).
# GEODE_PHONE_RESET=1
# Push the freshly built plugin-dist to the device once per run.
# GEODE_PHONE_PUSH=1
# Run phone specs against a throwaway local server on GEODE_PHONE_SERVER_PORT instead
# of GEODE_SERVER_URL (the device reaches it over `adb reverse`).
# GEODE_PHONE_HOST=1
